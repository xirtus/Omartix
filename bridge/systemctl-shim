#!/bin/bash
# systemctl shim for Artix Linux (runit)
# Place this in /usr/local/bin/systemctl

ARGS=("$@")
IS_USER=0
CMD=""
TARGETS=()

# Parse arguments
for arg in "${ARGS[@]}"; do
    case $arg in
        --user) IS_USER=1 ;;
        --now|--quiet|-q|--no-block) ;; # Ignore flags
        enable|disable|start|stop|restart|reload|status|is-enabled|daemon-reload|poweroff|reboot) CMD=$arg ;;
        -*) ;; # Ignore other flags
        *) TARGETS+=("$arg") ;;
    esac
done

# Handle Power commands
if [ "$CMD" == "poweroff" ]; then loginctl poweroff || shutdown -h now; exit 0; fi
if [ "$CMD" == "reboot" ]; then loginctl reboot || shutdown -r now; exit 0; fi
if [ "$CMD" == "daemon-reload" ]; then exit 0; fi

# Runit paths
SV_AVAIL="/etc/runit/sv"
# This is the persistent directory for enabled services
SV_ENABLED="/etc/runit/runsvdir/default"

# Service Name Mapping (Systemd -> Runit)
map_service_name() {
    local name=$1
    case $name in
        NetworkManager|NetworkManager.service) echo "NetworkManager" ;;
        bluetooth|bluetooth.service) echo "bluetoothd" ;;
        cups|cups.service) echo "cupsd" ;;
        docker|docker.service) echo "docker" ;;
        avahi-daemon|avahi) echo "avahi-daemon" ;;
        ufw|ufw.service) echo "ufw" ;;
        sddm|sddm.service) echo "sddm" ;;
        gdm|gdm.service) echo "gdm" ;;
        lightdm|lightdm.service) echo "lightdm" ;;
        *) echo "$name" | sed 's/\.service$//' ;;
    esac
}

if [ $IS_USER -eq 1 ]; then
    # User services are not standard in Runit/Artix default.
    # We ignore them to prevent errors in Omarchy scripts.
    exit 0
fi

for TARGET in "${TARGETS[@]}"; do
    RUNIT_NAME=$(map_service_name "$TARGET")

    case $CMD in
        enable)
            if [ -d "$SV_AVAIL/$RUNIT_NAME" ]; then
                # Link to persistent directory
                sudo ln -sf "$SV_AVAIL/$RUNIT_NAME" "$SV_ENABLED/$RUNIT_NAME"
                echo "Enabled $RUNIT_NAME (linked in $SV_ENABLED)"
            else
                echo "Warning: Service $RUNIT_NAME not found in $SV_AVAIL"
            fi
            ;;
        disable)
            sudo rm -f "$SV_ENABLED/$RUNIT_NAME"
            echo "Disabled $RUNIT_NAME"
            ;;
        start)
            # Runit auto-starts enabled services. 
            # If not enabled, we can't easily start it without supervision.
            # We assume 'start' implies 'ensure running'.
            if [ ! -L "$SV_ENABLED/$RUNIT_NAME" ]; then
                echo "Notice: Starting $RUNIT_NAME requires enabling it in runit."
                sudo ln -sf "$SV_AVAIL/$RUNIT_NAME" "$SV_ENABLED/$RUNIT_NAME"
            fi
            sudo sv start "$RUNIT_NAME" || true
            ;;
        stop)
            sudo sv stop "$RUNIT_NAME" || true
            ;;
        restart)
            sudo sv restart "$RUNIT_NAME" || true
            ;;
        status)
            sudo sv status "$RUNIT_NAME" || true
            ;;
        is-enabled)
            if [ -L "$SV_ENABLED/$RUNIT_NAME" ]; then exit 0; else exit 1; fi
            ;;
    esac
done